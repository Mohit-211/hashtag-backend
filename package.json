{
  "name": "hashtag-billionaire-node",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=16.20.1"
  },
  "nodemonConfig": {
    "ignore": [
      "**/public/uploads/**",
      "**/uploads/**",
      "src/services/public/uploads/**"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "staging": "pm2 start ecosystem.stagging-config.json --no-daemon",
    "dev": "nodemon --ext js,mjs,json,yaml index.js",
    "auth": "node src/config/createSuperAdmin.js",
    "migrate": "node src/config/migrateTable.js",
    "restore:supplier-images": "node src/scripts/restoreSupplierImages.js"
  },
  "author": "CA",
  "license": "UNLICENSED",
  "dependencies": {
    "@paypal/paypal-server-sdk": "^1.1.0",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "he": "^1.2.0",
    "helmet": "^6.0.1",
    "http-status": "^1.6.2",
    "joi": "^17.7.1",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.1.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.1",
    "openai": "^4.104.0",
    "password-validator": "^5.3.0",
    "sequelize": "^6.28.0",
    "slugify": "^1.6.6",
    "square": "^44.0.1",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
