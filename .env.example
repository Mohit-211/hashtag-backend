# Copy to .env and fill in. Variables marked (required) stop the app from starting if missing.

NODE_ENV=production                 # (required) production | development | test
PORT=5000
DEFAULT_TIMEZONE=UTC

# Database
CENTRAL_MYSQL_HOST=                 # (required)
CENTRAL_MYSQL_PORT=3306             # (required)
CENTRAL_MYSQL_USER=                 # (required)
CENTRAL_MYSQL_PASSWORD=
CENTRAL_MYSQL_DB=                   # (required)

# Auth
JWT_SECRET=                         # (required) at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_ACCESS_EXPIRATION_DAYS=5        # customer session length
USR_ROLE_ID=                        # (required) roles.id of customer accounts
SUP_ADM_ROLE_ID=                    # roles.id of the Super Admin role
ADM_DEPT_ID=
SUPER_ADMIN_NAME=                   # used by `npm run auth` to create the first Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Links in account emails (verification, password reset, account setup)
FRONTEND_URL=                       # (required) customer website, e.g. https://www.example.com
ADMIN_FRONTEND_URL=                 # (required) admin panel, e.g. https://admin.example.com

# Files (outside the repo). Defaults: ../storage and ../logs next to the repo,
# i.e. /var/www/storage and /var/www/logs when the code is in /var/www/backend.
STORAGE_DIR=
LOG_DIR=

# Networking
ACCESSDOMAINS=                      # allowed CORS origins, comma separated
TRUST_PROXY=loopback                # loopback when nginx runs on the same server. Behind Cloudflare,
                                    # add Cloudflare's ranges (https://www.cloudflare.com/ips/),
                                    # comma separated, or rate limits count per Cloudflare server
IMAGE_BASE_URL=                     # public address of this API, e.g. https://node.example.com
EXPOSE_SUPPLIER_COST=false          # true only while the shop switches to price_tiers
                                    # (keeps supplier cost fields in shopper responses)

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Suppliers and services
SS_USERNAME=
SS_PASSWORD=
SAGE_ACCT_ID=
SAGE_LOGIN_ID=
SAGE_API_KEY=
SHIPSTATION_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OTTOCAP_IMAGE_HOSTS=                # optional, comma separated; default: hosts in the OttoCap catalog

# Payments
SQUARE_ENVIRONMENT=                 # production | sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=

DEFAULT_API_DATA_LIMIT=15
DEFAULT_AMOUNT=5
