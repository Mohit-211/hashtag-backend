# Copy to .env and fill in. Variables marked (required) stop the app from starting if missing.
#
# Only what the server needs to start is here. Everything else (API keys, the mail server, the
# shipping sender, payment credentials, the website's links...) is set on the admin panel's
# Settings page and kept in the database, secrets encrypted: see docs/admin-settings.md. Until a
# value is saved there, a variable of the same name here still works (npm run settings:import
# copies them over).

NODE_ENV=production                 # (required) production | development | test
PORT=5000
DEFAULT_TIMEZONE=UTC

# Database
CENTRAL_MYSQL_HOST=                 # (required)
CENTRAL_MYSQL_PORT=3306             # (required)
CENTRAL_MYSQL_USER=                 # (required)
CENTRAL_MYSQL_PASSWORD=
CENTRAL_MYSQL_DB=                   # (required)

# Auth
JWT_SECRET=                         # (required) at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_ACCESS_EXPIRATION_DAYS=5        # customer session length
USR_ROLE_ID=                        # (required) roles.id of customer accounts
SUP_ADM_ROLE_ID=                    # roles.id of the Super Admin role
ADM_DEPT_ID=
SUPER_ADMIN_NAME=                   # `npm run auth` creates a Super Admin from these two and emails
SUPER_ADMIN_EMAIL=                  # them a set-password link (the mail server comes from Settings)

# The settings key (required): asked for on the admin panel's Settings page to show secrets in
# full or save changes, and used to encrypt the secrets in the database. At least 32 random
# characters, e.g. `openssl rand -hex 32`. To change it, see docs/admin-settings.md.
SETTINGS_MASTER_KEY=

# Server
STORAGE_DIR=                        # uploads and imports; default ../storage next to the repo
LOG_DIR=                            # log files; default ../logs next to the repo
ACCESSDOMAINS=                      # allowed CORS origins (website, admin panel), comma separated
TRUST_PROXY=loopback                # loopback when nginx runs on the same server. Behind Cloudflare,
                                    # add Cloudflare's ranges (https://www.cloudflare.com/ips/),
                                    # comma separated, or rate limits count per Cloudflare server
